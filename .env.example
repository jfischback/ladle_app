# Login is OFF unless this is "true" (everyone shares one built-in account).
REQUIRE_LOGIN=

# Auth.js secret: generate with `npx auth secret` (needed only when REQUIRE_LOGIN=true)
AUTH_SECRET=

# Google sign-in (optional). Callback URL: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres. On Vercel, connecting a Postgres (Neon) database sets DATABASE_URL / POSTGRES_URL.
# Leave empty locally to use the embedded database in .data/pglite.
DATABASE_URL=

# Claude API for the planner, grocery list and recipe import.
# Without it, the app uses a basic random planner and you can't import recipes.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Kroger Public API (developer.kroger.com). Turns on Fry's store search in setup.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Timezone used for "today" and the shopping week.
APP_TIMEZONE=America/Phoenix
